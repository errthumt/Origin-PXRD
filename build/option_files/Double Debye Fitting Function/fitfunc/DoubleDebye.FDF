[Python]
from scipy.integrate import quad
from math import exp

mJtoJ = 0.001

def integrand(x):
    return (x**4)*exp(x)/((exp(x)-1)**2)

def debye_term(T, R_const, debye_i):
    integrated, error = quad(integrand, 0, debye_i/T)
    return 9 * R_const * ((T/debye_i)**3) * integrated

def Cp_fitFunc(T, N_const, R_const, gamma, s, debye_1, debye_2, M):
    gamma_Joules = gamma*mJtoJ
    M_Joules = M*mJtoJ
    result = gamma_Joules*T
    result += debye_term(T, R_const, debye_1) * (N_const-s)
    result += debye_term(T, R_const, debye_2) * s
    result += M_Joules * (T**2)
    return result


