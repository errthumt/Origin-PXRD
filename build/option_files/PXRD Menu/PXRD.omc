<OriginStorage FileEnable="1" Position="1" version="1"><popup text="PXRD" tag="" wndType=" "><popup text="Import RAS Patterns" tag=""><item><LT>run -pyf rasImp.py &quot;files&quot;;</LT><LTEnable/><tlb/><Prompt>Select multiple individual RAS files to import.</Prompt><menutext>Select Files...</menutext></item><item><LT>run -pyf rasImp.py &quot;folder&quot;;</LT><LTEnable/><tlb/><Prompt><![CDATA[Select a folder containing multiple RAS files to import.]]></Prompt><menutext>Select Folder...</menutext></item></popup><popup text="Calculate CIF Patterns" tag=""><popup text="Cu-Ka (3-90deg)" tag=""><item><LT>run -pyf cifPicker.py &quot;file&quot;;
run -pyf cifImp.py &quot;CuKa&quot;;</LT><LTEnable/><tlb/><Prompt><![CDATA[Select one or more CIF files to calculate patterns with default CuKa settings.]]></Prompt><menutext>Select Files...</menutext></item><item><LT><![CDATA[run -pyf cifPicker.py "folder";
run -pyf cifImp.py "CuKa";]]></LT><LTEnable/><tlb/><Prompt>Select a folder containing one or more CIF files to calculate patterns with default CuKa settings.</Prompt><menutext>Select Folder...</menutext></item></popup><popup text="Custom Parameters" tag=""><item><LT><![CDATA[run -pyf cifPicker.py "file";
run -pyf cifImp.py "custom";]]></LT><LTEnable/><tlb/><Prompt><![CDATA[Select one or more CIF files to calculate patterns with custom wavelength, range, and/or step size.]]></Prompt><menutext>Select Files...</menutext></item><item><LT>run -pyf cifPicker.py &quot;folder&quot;;
run -pyf cifImp.py &quot;custom&quot;;</LT><LTEnable/><tlb/><Prompt>Select a folder containing one or more CIF files to calculate patterns with custom wavelength, range, and/or step size.</Prompt><menutext>Select Folder...</menutext></item></popup><popup text="11-ID-C March 2026" tag="" wndType=" "><item><LT>run -pyf cifPicker.py &quot;file&quot;;
run -pyf cifImp.py &quot;11-ID-C March 2026&quot;;</LT><LTEnable/><tlb/><Prompt><![CDATA[Select one or more CIF files to calculate patterns with custom settings to match 11-ID-C.]]></Prompt><menutext>Select Files...</menutext></item><item><LT><![CDATA[run -pyf cifPicker.py "folder";
run -pyf cifImp.py "11-ID-C March 2026";]]></LT><LTEnable/><tlb/><Prompt>Select a folder containing one or more CIF files to calculate patterns with custom settings to match 11-ID-C.</Prompt><menutext>Select Folder...</menutext></item></popup></popup><popup text="Transform Columns" tag="" wndType="W"><popup text="Add Q Columns" tag="" wndType="W"><item><LT><![CDATA[run -pyf qSpace.py "all_deg"]]></LT><LTEnable/><tlb/><Prompt>Calculate Q values with specified wavelength for any column with &quot;deg&quot; as units (Assumes 2theta)</Prompt><menutext>All &quot;deg&quot;</menutext></item><item><LT><![CDATA[run -pyf qSpace.py "selected"]]></LT><LTEnable/><tlb/><Prompt>Calculate Q values with specified wavelength for currently selected columns (Assumes 2theta)</Prompt><menutext>Selected Columns</menutext></item></popup><popup text="Rescale Columns" tag="" wndType="W"><item><LT>run -pyf transform.py &quot;au&quot; &quot;scale&quot;</LT><LTEnable><![CDATA[]]></LTEnable><tlb/><Prompt>Adds a column with a custom scale factor for every column with units &quot;AU&quot;</Prompt><menutext>All &quot;AU&quot;</menutext></item><item><LT>run -pyf transform.py &quot;gui&quot; &quot;scale&quot;</LT><LTEnable/><tlb/><Prompt>Adds a column with a custom scale factor for every selected column.</Prompt><menutext>Selected Columns</menutext></item></popup><popup text="Square Columns" tag=""><item><LT>run -pyf transform.py &quot;au&quot; &quot;square&quot;;</LT><LTEnable/><tlb/><Prompt>Adds a column with intensity squared for every column with units &quot;AU&quot;</Prompt><menutext>All &quot;AU&quot;</menutext></item><item><LT><![CDATA[run -pyf transform.py "gui" "square";]]></LT><LTEnable/><tlb/><Prompt>Adds a column with a intensity squared for every selected column.</Prompt><menutext>Selected Columns</menutext></item></popup><popup text="Sqrt Columns" tag=""><item><LT>run -pyf transform.py &quot;au&quot; &quot;sqrt&quot;;</LT><LTEnable/><tlb/><Prompt>Adds a column with sqrt[Intensity] for every column with units &quot;AU&quot;</Prompt><menutext>All &quot;AU&quot;</menutext></item><item><LT><![CDATA[run -pyf transform.py "gui" "sqrt";]]></LT><LTEnable/><tlb/><Prompt>Adds a column with sqrt[Intensity] for every selected column.</Prompt><menutext>Selected Columns</menutext></item></popup></popup><popup text="In-Situ Processing" tag=""><item><LT>run -pyf process11ID.py</LT><LTEnable><![CDATA[]]></LTEnable><tlb/><Prompt><![CDATA[Pull all powder patterns in a sample folder and attach the corresponding temperature as a "Temp" row at the top. Only available if you selected this option during install.]]></Prompt><menutext>11-ID-C (March 2026)</menutext></item></popup></popup></OriginStorage>