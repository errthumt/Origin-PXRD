	<codes NodeID="268435456" DataID="324">
		<rettype NodeID="11" DataID="41">void</rettype>
		<header NodeID="45" DataID="323" MultilineEditExpShrink="1" DispFormat="33554432" RowHeightRange="3-15">
			<![CDATA[//put additional include files here


//put your own support static functions here
int IMPORT_TYPE_NROW=1;
int DOUBLET_NROW=3;
int X_AXIS_START=8;
int X_AXIS_END=13;
int CIF_NORM_NROW=22;
]]>
		</header>
		<code NodeID="45" DataID="325" MultilineEditExpShrink="1" DispFormat="33554432" RowHeightRange="5-20">
			<![CDATA[string lt_cmd;
string file_mode;
string norm_mode;
string doublet_string = doublet ? "true" : "false";
bool phase_frac;
bool do_q=false;

if(import_type==0) {
	lt_cmd = "py.PXRD.import_ras_from_xf(\"";
	norm_mode = (norm_mode_ras==0 ? "true" : "false");
}

else {
	lt_cmd = "py.PXRD.import_cifs_from_xf(\"";
	lt_cmd += "doublet:" + doublet_string;
    lt_cmd += ", wavelength1:" + wavelength1;
    lt_cmd += ", weight1:" + weight1;
    lt_cmd += ", wavelength2:" + wavelength2;
    lt_cmd += ", weight2:" + weight2;
    lt_cmd += ", start_2th:" + start_2th;
    lt_cmd += ", end_2th:" + end_2th;
    lt_cmd += ", step_2th:" + step_2th;
    lt_cmd += ", U:" + U_var;
    lt_cmd += ", V:" + V_var;
    lt_cmd += ", W:" + W_var;
    lt_cmd += ", X:" + X_var;
    lt_cmd += ", Y:" + Y_var;
    lt_cmd += ", axial_S:" + axial_S;
    lt_cmd += ", ";
    
    if(norm_mode_cif==2) {
		phase_frac=true;
		norm_mode="false";
    }
    else norm_mode=(norm_mode_cif==0 ? "true" : "false");
    
    do_q = q_mode;
}
file_mode = (selection_type==0 ? "files" : "folder");
lt_cmd += "file_mode:" + file_mode;
lt_cmd += ", normalize_mode:" + norm_mode;
lt_cmd += ", book_name:" + book_name;
lt_cmd += "\");";

if(phase_frac) {
	lt_cmd += "py.PXRD.add_phase_fractions(\"";

	if(frac_mode==1) {lt_cmd += "weight";} else if(frac_mode==2) {lt_cmd += "cell";} else {lt_cmd += "moles";}
		
	lt_cmd += "\");";
}
if(do_q) lt_cmd += "py.PXRD.transform_columns(\"deg\",\"qspace\");";

LT_execute(lt_cmd);

return;]]>
		</code>
		<event1 NodeID="45" DataID="327" MultilineEditExpShrink="1" DispFormat="33554432" RowHeightRange="5-20" Show="0">
			<![CDATA[
int return_value=false;

// On Import Type Change
if(nRow == IMPORT_TYPE_NROW || nEventID < 0) {
	bool show = (trGetN.import_type.nVal != 0);

	trGetN.doublet.Show      = show;
	trGetN.wavelength1.Show  = show;
	trGetN.weight1.Show      = show;
	trGetN.wavelength2.Show  = show;
	trGetN.weight2.Show      = show;
	trGetN.q_mode.Show       = show;
	trGetN.start_2th.Show    = show;
	trGetN.end_2th.Show      = show;
	trGetN.step_2th.Show	 = show;
	trGetN.start_q.Show      = show;
	trGetN.end_q.Show        = show;
	trGetN.U_var.Show        = show;
	trGetN.V_var.Show        = show;
	trGetN.W_var.Show        = show;
	trGetN.X_var.Show        = show;
	trGetN.Y_var.Show        = show;
	trGetN.axial_S.Show      = show;
	trGetN.norm_mode_cif.Show	 = show;
	trGetN.norm_mode_ras.Show 	 = !show;
	trGetN.frac_mode.Show = ((trGetN.norm_mode_cif.nVal == 2) && show);
	
	if(trGetN.book_name.strVal == "RAS Imports" || trGetN.book_name.strVal =="CIF Imports") {
		trGetN.book_name.strVal = (show ? "CIF Imports" : "RAS Imports");
	}

	return_value = true;
}

// On cif normalization type change
if(nRow == CIF_NORM_NROW || nEventID < 0) {
	trGetN.frac_mode.Show = (trGetN.norm_mode_cif.nVal == 2);

return_value = true;
}

// On doublet change
if(nRow == DOUBLET_NROW || nEventID < 0) {
	bool show = (trGetN.doublet.nVal != 0);
	trGetN.weight1.Show      = show;
	trGetN.wavelength2.Show  = show;
	trGetN.weight2.Show      = show;

	return_value = true;
}

// q_mode toggle logic
if( (nRow >= X_AXIS_START && nRow <= X_AXIS_END) || nEventID < 0 )
{
	bool qmode = (trGetN.q_mode.nVal == 1);
	double lambda = trGetN.wavelength1.dVal;   // primary wavelength

	if(qmode)
	{
		// --- Q MODE ACTIVE ---

		// Show + enable Q fields
		trGetN.start_q.Show = true;
		trGetN.end_q.Show   = true;
		trGetN.start_q.Enable = true;
		trGetN.end_q.Enable   = true;

		// 2theta fields visible but disabled
		trGetN.start_2th.Enable = false;
		trGetN.end_2th.Enable   = false;

		// Convert Q → 2theta
		double q1 = trGetN.start_q.dVal;
		double q2 = trGetN.end_q.dVal;

		double factor = lambda / (4 * PI);

		double th1 = 2.0 * asin(q1 * factor) * 180.0 / PI;
		double th2 = 2.0 * asin(q2 * factor) * 180.0 / PI;

		// Push recalculated values
		trGetN.start_2th.dVal = th1;
		trGetN.end_2th.dVal   = th2;

		return_value = true;
	}
	else
	{
		// --- 2THETA MODE ACTIVE ---

		// Hide + disable Q fields
		trGetN.start_q.Show = false;
		trGetN.end_q.Show   = false;
		trGetN.start_q.Enable = false;
		trGetN.end_q.Enable   = false;

		// 2theta fields editable
		trGetN.start_2th.Enable = true;
		trGetN.end_2th.Enable   = true;

		// Convert 2theta → Q
		double th1 = trGetN.start_2th.dVal * PI / 180.0;
		double th2 = trGetN.end_2th.dVal   * PI / 180.0;

		double q1 = (4 * PI / lambda) * sin(th1 / 2.0);
		double q2 = (4 * PI / lambda) * sin(th2 / 2.0);

		// Store Q values (hidden but kept in sync)
		trGetN.start_q.dVal = q1;
		trGetN.end_q.dVal   = q2;

		return_value = true;
	}
}
return return_value;]]>
		</event1>
