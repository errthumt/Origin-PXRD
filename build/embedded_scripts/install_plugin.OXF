		<code NodeID="45" DataID="325" MultilineEditExpShrink="1" DispFormat="33554432" RowHeightRange="5-20">
			<![CDATA[string lt_cmd;
string boolStr;

lt_cmd = "run -pyp installNew \"";

boolStr = menu ? "true" : "false";
lt_cmd += "PXRD Menu: " + boolStr;

boolStr = inSitu ? "true" : "false";
lt_cmd += ", In-Situ Beamline Processing: " + boolStr;

boolStr = anneal ? "true" : "false";
lt_cmd += ", Annealing Profiles: " + boolStr;

boolStr = graph ? "true" : "false";
lt_cmd += ", Graph Templates: " + boolStr;

lt_cmd += "\";";
LT_execute(lt_cmd);]]>
		</code>
